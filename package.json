{
	"name": "dreamyfishmt-kimi-code",
	"displayName": "%extension.displayName%",
	"description": "%extension.description%",
	"version": "0.6.5",
	"publisher": "dreamyfishmt",
	"license": "MIT",
	"repository": "https://github.com/dreamyfishmt/kimi-copilot-provider",
	"icon": "images/icon.png",
	"engines": {
		"vscode": "^1.120.0"
	},
	"categories": [
		"AI",
		"Chat"
	],
	"keywords": [
		"language-models"
	],
	"activationEvents": [
		"onStartupFinished",
		"onLanguageModelChatProvider:kimi"
	],
	"extensionKind": [
		"workspace",
		"ui"
	],
	"main": "./out/extension.js",
	"l10n": "./l10n",
	"contributes": {
		"configuration": {
			"title": "%config.title%",
			"properties": {
				"kimi.showUsageStatusBar": {
					"type": "boolean",
					"default": true,
					"scope": "application",
					"description": "%config.showUsageStatusBar.description%"
				},
				"kimi.endpoint": {
					"type": "string",
					"enum": [
						"kimiCode",
						"kimiCodeCN",
						"moonshot",
						"moonshotCN",
						"custom"
					],
					"enumItemLabels": [
						"%config.endpoint.enum.kimiCode%",
						"%config.endpoint.enum.kimiCodeCN%",
						"%config.endpoint.enum.moonshot%",
						"%config.endpoint.enum.moonshotCN%",
						"%config.endpoint.enum.custom%"
					],
					"default": "kimiCode",
					"scope": "application",
					"markdownDescription": "%config.endpoint.markdownDescription%"
				},
				"kimi.apiBaseUrl": {
					"type": "string",
					"default": "https://api.kimi.ai/coding/v1",
					"scope": "application",
					"markdownDescription": "%config.apiBaseUrl.markdownDescription%"
				},
				"kimi.maxOutputTokens": {
					"type": "integer",
					"minimum": 1,
					"maximum": 65536,
					"default": 32768,
					"scope": "application",
					"markdownDescription": "%config.maxOutputTokens.markdownDescription%"
				},
				"kimi.sendDeviceInfo": {
					"type": "boolean",
					"default": false,
					"scope": "application",
					"markdownDescription": "%config.sendDeviceInfo.markdownDescription%"
				},
				"kimi.reasoningEffort": {
					"type": "string",
					"enum": [
						"default",
						"low",
						"high",
						"max"
					],
					"enumItemLabels": [
						"%config.reasoningEffort.enum.default%",
						"%config.reasoningEffort.enum.low%",
						"%config.reasoningEffort.enum.high%",
						"%config.reasoningEffort.enum.max%"
					],
					"default": "default",
					"scope": "application",
					"markdownDescription": "%config.reasoningEffort.markdownDescription%"
				}
			}
		},
		"languageModelChatProviders": [
			{
				"vendor": "kimi",
				"displayName": "Kimi",
				"configuration": {
					"type": "object",
					"properties": {
						"apiKey": {
							"type": "string",
							"description": "%provider.apiKey.description%",
							"title": "%provider.apiKey.title%",
							"secret": true
						}
					},
					"required": [
						"apiKey"
					]
				}
			}
		],
		"commands": [
			{
				"command": "kimi.diagnoseConfiguration",
				"title": "%command.diagnoseConfiguration%"
			},
			{
				"command": "kimi.refreshModels",
				"title": "%command.refreshModels%"
			},
			{
				"command": "kimi.refreshUsage",
				"title": "%command.refreshUsage%"
			},
			{
				"command": "kimi.usageActions",
				"title": "%command.usageActions%"
			},
			{
				"command": "kimi.testConnection",
				"title": "%command.testConnection%"
			},
			{
				"command": "kimi.setBaseUrl.kimiCode",
				"title": "%command.setBaseUrl.kimiCode%"
			},
			{
				"command": "kimi.setBaseUrl.kimiCodeCN",
				"title": "%command.setBaseUrl.kimiCodeCN%"
			},
			{
				"command": "kimi.setBaseUrl.moonshot",
				"title": "%command.setBaseUrl.moonshot%"
			},
			{
				"command": "kimi.setBaseUrl.moonshotCN",
				"title": "%command.setBaseUrl.moonshotCN%"
			},
			{
				"command": "kimi.setBaseUrl.custom",
				"title": "%command.setBaseUrl.custom%"
			}
		],
		"menus": {
			"commandPalette": [
				{
					"command": "kimi.testConnection",
					"when": "false"
				}
			]
		}
	},
	"scripts": {
		"test": "tsc -p ./ && node --test tests/*.cjs",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"vscode:prepublish": "tsc -p ./",
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"build:local": "pnpm dlx @vscode/vsce@4.0.0 package --no-dependencies",
		"calibrate:tokens": "tsc -p ./ && node scripts/token-calibration.cjs"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@stylistic/eslint-plugin": "5.10.0",
		"@types/node": "20.19.30",
		"@types/vscode": "^1.120.0",
		"eslint": "10.12.0",
		"globals": "17.13.0",
		"typescript": "5.9.3",
		"typescript-eslint": "8.71.1"
	},
	"packageManager": "pnpm@10.28.0"
}
