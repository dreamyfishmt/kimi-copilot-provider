    "version": "0.2.0",
    "configurations": [
        
        {
            "type": "extensionHost",
            "request": "launch",
            "name": "Run Kimi ext",
             "args": [
                "--extensionDevelopmentPath=${workspaceFolder}",
                "--enable-proposed-api=dreamyfishmt.kimi-lm-provider"
            ],
            "outFiles": [
                "${workspaceFolder}/out/**/*.js"
            ]
        }
    ]
}